{
	"compilerOptions": {
		"target": "ESNext",
		"module": "NodeNext",
		"strict": true,
		// Indexing an array can always yield undefined. Enabled because most of
		// the data this service handles comes from an upstream with no schema
		// guarantees, and silent undefined is exactly how that bites.
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"types": ["node"],
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",
		"noEmit": true
	},
	"include": ["src", "scripts"],
	"exclude": ["node_modules", "dist"]
}
