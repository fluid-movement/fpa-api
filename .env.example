# Copy to .env for local development. Every value below is the built-in default,
# so an empty .env works fine — this file documents what is tunable.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# Comma-separated CORS allowlist. Leave unset for server-to-server only, which
# is the intended deployment: fpa-events calls this from its backend.
# CORS_ORIGINS=https://events.example.org

# ── Refresh control ──────────────────────────────────────────────────────────
# Bearer token for POST /refresh. UNSET DISABLES THE ROUTE — it fails closed
# rather than sitting open. Set this in any real deployment.
# REFRESH_TOKEN=change-me

# How often to sync from upstream (default 1 hour). A quiet sync is two small
# manifest requests; only new or changed events, players and ranking snapshots
# are fetched. Use POST /refresh for immediacy instead of a tighter interval.
SYNC_INTERVAL_MS=3600000

# Per-request upstream timeout.
REQUEST_TIMEOUT_MS=30000

# ── Persistence ──────────────────────────────────────────────────────────────
# Last-good sync state, so a restart during an upstream outage still serves
# data and the next sync only fetches what changed. Mount a writable volume
# here in production.
SNAPSHOT_PATH=./data/snapshot.json

# ── Upstream ─────────────────────────────────────────────────────────────────
# FullstackFreestyleTools: the sync API (/api/v1/sync/*, see docs/SYNC_API.md)
# and the Points API (/api/v1/points/*). Point at a local instance to develop
# against it, e.g. http://localhost:3100.
UPSTREAM_BASE_URL=https://freestylejudge.com

# ── Player profiles ──────────────────────────────────────────────────────────
# Base URL of fpa-profiles, the editor for player profile enrichment. Its
# /export is pulled with every sync. Unset disables profiles.
# PROFILES_URL=http://localhost:5173
