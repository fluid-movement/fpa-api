# Copy to .env for local development. Every value below is the built-in default,
# so an empty .env works fine — this file documents what is tunable.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# Comma-separated CORS allowlist. Leave unset for server-to-server only, which
# is the intended deployment: fpa-events calls this from its backend.
# CORS_ORIGINS=https://events.example.org

# ── Refresh control ──────────────────────────────────────────────────────────
# Bearer token for POST /refresh. UNSET DISABLES THE ROUTE — it fails closed
# rather than sitting open. Set this in any real deployment.
# REFRESH_TOKEN=change-me

# Full corpus refetch floor (default 1 hour). Read docs/OPERATIONS.md before
# lowering this: a full refresh pulls ~5 MB uncompressed from a third party's
# AWS account. Use POST /refresh for immediacy instead of a tighter poll.
FULL_REFRESH_INTERVAL_MS=3600000

# Cheap probes that escalate to a full refresh when they detect a change.
DIRECTORY_PROBE_INTERVAL_MS=60000
MANIFEST_PROBE_INTERVAL_MS=600000

# Per-request upstream timeout.
REQUEST_TIMEOUT_MS=30000

# ── Persistence ──────────────────────────────────────────────────────────────
# Last-good corpus, so a restart during an upstream outage still serves data.
# Mount a writable volume here in production.
SNAPSHOT_PATH=./data/snapshot.json

# ── Privacy ──────────────────────────────────────────────────────────────────
# Player gender and FPA membership number are personal data and are withheld
# unless this is true. Confirm with the upstream maintainer what is intended to
# be public before enabling.
EXPOSE_PERSONAL_FIELDS=false

# ── Event liveness ───────────────────────────────────────────────────────────
# Events still being judged are withheld from the index: their results are
# partial and keep changing until the head judge locks the last pool. The
# signal is per-pool `isLocked` from the judging service, not presence in
# getEventDirectory — see docs/UPSTREAM.md, "Pool locks are the finished
# signal". Set true to consume in-progress events anyway.
CONSUME_IN_PROGRESS_EVENTS=false

# ── Upstream base URLs ───────────────────────────────────────────────────────
# Third-party AWS API Gateway endpoints. These IDs change if the services are
# redeployed, which is why they are configuration and not constants — see
# docs/OPERATIONS.md, "Upstream returned 403/404".
UPSTREAM_PLAYERS=https://4wnda3jb78.execute-api.us-west-2.amazonaws.com/production
UPSTREAM_EVENTS=https://wyach4oti8.execute-api.us-west-2.amazonaws.com/production
UPSTREAM_RESULTS=https://v869a98rf9.execute-api.us-west-2.amazonaws.com/production
UPSTREAM_POINTS=https://kvq5a3et4b.execute-api.us-west-2.amazonaws.com/production
UPSTREAM_JUDGING=https://xf4cu1wy10.execute-api.us-west-2.amazonaws.com/production
