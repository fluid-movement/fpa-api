# Keep the build context small and prevent host artifacts leaking into the image.
node_modules
dist
data
.git
.gitignore
*.log

# Never ship secrets, even though the Dockerfile does not COPY them.
.env
.env.*
!.env.example

# Not needed to build or run the service.
docs
scripts
*.test.ts
vitest.config.ts
README.md
.DS_Store
